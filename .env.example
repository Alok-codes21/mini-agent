# Telegram bot token - @BotFather se milta hai
TELEGRAM_BOT_TOKEN=yahan_bot_token_daalo

# Sirf TERA Telegram user ID (number) - koi aur use nahi kar payega
# Apna ID jaanne ke liye Telegram pe @userinfobot ko message karo
ALLOWED_TELEGRAM_ID=123456789

# Groq API key (free) - https://console.groq.com/keys se banao
GROQ_API_KEY=yahan_groq_key_daalo

# (Optional) Gemini API key - Groq fail kare toh yeh fallback chalega
# https://aistudio.google.com/apikey se free milta hai
GEMINI_API_KEY=
